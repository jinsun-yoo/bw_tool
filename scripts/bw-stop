#!/usr/bin/env bash
# bw-stop: stop the running bandwidth monitor daemon.
#
# Usage: bw-stop [-d|--device <ib_device>]
#   --device stops the daemon started with the matching bw-start --device.

set -euo pipefail

DEVICE=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -d|--device)
            if [[ $# -lt 2 ]]; then
                echo "Error: $1 requires a device name." >&2
                exit 1
            fi
            DEVICE="$2"
            shift 2
            ;;
        -h|--help)
            echo "Usage: bw-stop [-d|--device <ib_device>]"
            exit 0
            ;;
        *)
            echo "Error: unexpected argument '$1'." >&2
            exit 1
            ;;
    esac
done

if [[ -n "${DEVICE}" ]]; then
    PIDFILE="/tmp/bw_monitor-${DEVICE}.pid"
else
    PIDFILE="/tmp/bw_monitor.pid"
fi

if [[ ! -f "${PIDFILE}" ]]; then
    echo "bw_monitor does not appear to be running (no PID file found)." >&2
    exit 1
fi

PID="$(cat "${PIDFILE}")"

if ! kill -0 "${PID}" 2>/dev/null; then
    echo "No process with PID ${PID} found. Removing stale PID file." >&2
    rm -f "${PIDFILE}"
    exit 1
fi

echo "Stopping bw_monitor (PID ${PID})..."
kill -TERM "${PID}"

# Wait up to 5 seconds for the process to exit
for i in $(seq 1 50); do
    if ! kill -0 "${PID}" 2>/dev/null; then
        echo "bw_monitor stopped."
        rm -f "${PIDFILE}"
        exit 0
    fi
    sleep 0.1
done

echo "Process did not stop within 5s; sending SIGKILL." >&2
kill -KILL "${PID}" 2>/dev/null || true
rm -f "${PIDFILE}"
